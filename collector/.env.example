YOUTUBE_API_KEY=

# Points at the local copy (chillwhispers_local, same GoBase connection as
# "api.chillwhispers.com (Local)") by default. Do not repoint this at the
# remote/production DB (web1.trustnetsolutions.ro) without checking first --
# collected videos should stay staged locally until a sprint explicitly adds
# a migrate-to-production task.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chill_local
DB_PASS=chill_local
DB_NAME=chillwhispers_local

# How many videos each channel should end up with (top-up, not replace).
TARGET_PER_CHANNEL=100

# Optional cap on how many channels to touch in one run. Empty = all channels
# with fewer than TARGET_PER_CHANNEL videos, ordered by the ones furthest
# behind first. Default to a small number -- ask before widening this.
MAX_CHANNELS=5

# true = fetch and print what would be inserted, write nothing.
DRY_RUN=true
